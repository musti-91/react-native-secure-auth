{
  "name": "react-native-secure-auth",
  "version": "1.0.0",
  "description": "React Native bridge for AppAuth (OAuth 2.0 / OpenID Connect) with customizable browser headers, browser postMessage messaging, discovery helpers and automatic token refresh",
  "main": "index.js",
  "author": "musti-91",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musti-91/react-native-secure-auth.git"
  },
  "homepage": "https://github.com/musti-91/react-native-secure-auth#readme",
  "bugs": {
    "url": "https://github.com/musti-91/react-native-secure-auth/issues"
  },
  "types": "index.d.ts",
  "react-native": "index.js",
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "test:plugin": "jest --config plugin/jest.config.js",
    "prepare": "npm run build:plugin"
  },
  "files": [
    "android/build.gradle",
    "android/src",
    "ios",
    "src",
    "plugin/build",
    "plugin/src",
    "!plugin/src/__tests__",
    "app.plugin.js",
    "index.js",
    "index.d.ts",
    "react-native-secure-auth.podspec"
  ],
  "keywords": [
    "react",
    "react-native",
    "auth",
    "authentication",
    "oauth",
    "oauth2",
    "openid",
    "appauth",
    "custom-tabs",
    "postmessage"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "^58.0.9",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/react-test-renderer": "^19",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-test-renderer": "19.3.0",
    "ts-jest": "^29.4.4",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/example/",
      "/plugin/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/"
    ]
  },
  "packageManager": "yarn@4.9.2"
}
